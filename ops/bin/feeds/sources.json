{
  "_readme": [
    "Pinward 资讯源配置。所有源均在真实网络下实测可通后才写入本文件。",
    "字段说明：",
    "  id            唯一标识，出现在日志与 digest.json.failures 里",
    "  label         人类可读名字，出现在 digest.md 的「来源」位置",
    "  type          rss（默认，RSS 2.0 / Atom 通用解析）| google-news（由 query 拼 URL）| hn（Algolia JSON）",
    "  query         仅 type=google-news 使用；hl/gl/ceid 可选，默认 en-US / US",
    "  url           直接给出 feed 地址（type=rss / hn）",
    "  category      digest.md 的分组：玩法与设计 / 竞品动态 / 技术 / UI 与美术 / 手感与特效 / 行业动态",
    "  maxItems      单个源最多取多少条，默认由 defaults.maxItemsPerSource 决定",
    "  maxAgeHours   可选，覆盖该源的全局 --hours；出厂配置故意不启用（时间窗对所有源一视同仁）",
    "  optional      true 表示失败即静默跳过（只写 digest.json.optionalFailures），不进 digest.md 的失败小节",
    "  enabled       false 可临时停用某个源",
    "  delayMs       抓取前等待毫秒数，用于给 Reddit 这类有速率限制的站点错峰"
  ],
  "defaults": {
    "timeoutMs": 20000,
    "maxItemsPerSource": 25
  },
