[Unit]
Description=PINWARD 自动化任务（%i）
Documentation=https://github.com/zidanDirk/pinward
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pinward
Group=pinward
WorkingDirectory=/opt/pinward/app

# 凭据由 systemd 以 root 读取后注入进程环境（文件权限 600 root:root）
EnvironmentFile=/etc/pinward/agent.env
Environment=PINWARD_ROOT=/opt/pinward
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LANG=C.UTF-8
Environment=NODE_OPTIONS=--max-old-space-size=1024

ExecStart=/opt/pinward/app/ops/bin/pinward %i

# 2 GB 内存的硬保护：超限只杀本单元，不拖垮整机
MemoryHigh=1200M
MemoryMax=1700M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# 单次运行最长 2 小时
TimeoutStartSec=7200
TimeoutStopSec=60
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pinward-%i
